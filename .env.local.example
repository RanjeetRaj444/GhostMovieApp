# TMDB API Read Access Token (v4 auth) — SERVER-SIDE ONLY.
# Unlike the old Vite setup, this is NEVER exposed to the browser.
# Get yours at https://www.themoviedb.org/settings/api
TMDB_TOKEN=your_tmdb_v4_read_access_token_here

# Public site URL (used for canonical tags, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://ghost-movie-app.vercel.app

# --- Ads (leave OFF until AdSense approves the site) ---
# Flip to true only after approval to start rendering ad units.
NEXT_PUBLIC_ADS_ENABLED=false
# Ad unit slot ids you create in your AdSense dashboard:
NEXT_PUBLIC_AD_SLOT_ARTICLE=
NEXT_PUBLIC_AD_SLOT_LISTING=

# --- Analytics (optional) ---
# Set your GA4 Measurement ID (e.g. G-XXXXXXXXXX) to enable analytics.
NEXT_PUBLIC_GA_ID=
